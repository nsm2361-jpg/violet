name: Build Violet Lite (AI 추천 + 번역)
on:
  push:
  workflow_dispatch:
jobs:
 build:
  runs-on: ubuntu-latest
  permissions:
   contents: write
  defaults:
   run:
    working-directory: violet
  steps:
  - uses: actions/checkout@v4
  - name: Add taste recommend page
    run: |
     cat > lib/pages/bookmark/taste_recommend_page.dart <<'DART'
     import 'dart:math';
     import 'package:flutter/material.dart';
     import 'package:provider/provider.dart';
     import 'package:shared_preferences/shared_preferences.dart';
     import 'package:violet/algorithm/distance.dart';
     import 'package:violet/component/hitomi/hybrid_loader.dart';
     import 'package:violet/component/index.dart';
     import 'package:violet/component/query_translate.dart';
     import 'package:violet/database/database.dart';
     import 'package:violet/database/query.dart';
     import 'package:violet/database/user/bookmark.dart';
     import 'package:violet/database/user/record.dart';
     import 'package:violet/model/article_list_item.dart';
     import 'package:violet/settings/settings.dart';
     import 'package:violet/widgets/article_item/article_list_item_widget.dart';
     class TasteRecommendPage extends StatefulWidget {
     const TasteRecommendPage({super.key});
     @override
     State<TasteRecommendPage> createState() => _TasteRecommendPageState();
     }
     enum _Mode { taste, recent }
     class _Cand {
     _Cand(this.id, this.q, this.score, this.reason);
     final int id;
     final QueryResult q;
     final double score;
     final String reason;
     }
     class _Profile {
     final Map<String, double> weights = {};
     final Map<String, dynamic> vec = {};
     List<(String, ArtistType)> artists = [];
     final List<(String, ArtistType, double, String)> similar = [];
     final Map<int, _Cand> pool = {};
     bool built = false;
     bool similarComputed = false;
     int sourceCount = 0;
     }
     class _TasteRecommendPageState extends State<TasteRecommendPage> {
     static const int _kResultCount = 20;
     static const int _kProfileArticleLimit = 80;
     static const int _kRecentLimit = 30;
     static const int _kNetworkFetchLimit = 12;
     static const int _kChunkSize = 300;
     static const int _kKeepPerChunk = 25;
     static const int _kMaxArtistSourcePerDraw = 7;
     static const int _kMaxSimilarPerDraw = 7;
     static const int _kMaxPerArtist = 2;
     static const int _kSeenKeep = 400;
     static const String _kSeenKey = 'ai_recommend_seen_ids';
     final Random _rand = Random();
     _Mode _mode = _Mode.taste;
     final Map<_Mode, _Profile> _profiles = {
     _Mode.taste: _Profile(),
     _Mode.recent: _Profile(),
     };
     _Profile get _p => _profiles[_mode]!;
     bool _loading = true;
     final Set<_Mode> _fillingModes = {};
     bool get _filling => _fillingModes.contains(_mode);
     String _status = '';
     String? _message;
     String _drawInfo = '';
     final Set<int> _bookmarkedIds = {};
     final Set<int> _readIds = {};
     final List<int> _recentReadIds = [];
     final Set<int> _shownIds = {};
     final List<int> _seenOrder = [];
     List<(String, ArtistType)> _favArtists = [];
     Set<String> _excluded = {};
     int _rollCount = 0;
     int? _minId;
     int? _maxId;
     List<_Cand> _results = [];
     bool get _hasDb => _minId != null && _maxId != null && _maxId! > _minId!;
     @override
     void initState() {
     super.initState();
     _init();
     }
     void _setStatus(String s) {
     if (mounted) setState(() => _status = s);
     }
     Future<void> _step(String status, Future<void> Function() job) async {
     if (!mounted) return;
     _setStatus(status);
     try {
     await job().timeout(const Duration(seconds: 20));
     } catch (_) {}
     }
     Future<void> _init() async {
     try {
     _setStatus('기록 불러오는 중...');
     await _loadSeen();
     await _loadIdRange();
     await _loadBase();
     } catch (e) {
     if (!mounted) return;
     setState(() {
     _loading = false;
     _message = '정보를 불러오지 못했어요.\n$e';
     });
     return;
     }
     await _enterMode(_Mode.taste);
     }
     String _norm(String s) => s
     .trim()
     .toLowerCase()
     .replaceAll(' ', '_')
     .replaceFirst(RegExp(r'^tag:'), '');
     String _tokenOf(String group, String name) {
     final n = _norm(name);
     if (n.isEmpty) return '';
     return (group == 'female' || group == 'male') ? '$group:$n' : n;
     }
     bool _isExcluded(String token) {
     if (_excluded.contains(token)) return true;
     final i = token.indexOf(':');
     return i >= 0 && _excluded.contains(token.substring(i + 1));
     }
     List<(String, String)> _tagsOf(QueryResult m) {
     try {
     return m.tagList();
     } catch (_) {
     return const [];
     }
     }
     bool _hasExcluded(QueryResult m) =>
     _tagsOf(m).any((t) => _isExcluded(_tokenOf(t.$1, t.$2)));
     int? _idOf(QueryResult q) => int.tryParse('${q.result['Id']}');
     bool _isNew(int id) =>
     !_bookmarkedIds.contains(id) &&
     !_readIds.contains(id) &&
     !_shownIds.contains(id);
     List<String> _splitNames(dynamic s) => '${s ?? ''}'
     .split('|')
     .map((e) => e.trim())
     .where((e) => e.isNotEmpty && e != 'n/a')
     .toList();
     String _mainArtist(QueryResult q) {
     final a = _splitNames(q.artists());
     if (a.isNotEmpty) return a.first;
     final g = _splitNames(q.groups());
     return g.isNotEmpty ? g.first : '';
     }
     String _lang() {
     final langs = HybridLoader.getSelectedLanguages();
     return langs.length == 1 ? langs.first : 'all';
     }
     Future<void> _loadSeen() async {
     try {
     final prefs = await SharedPreferences.getInstance();
     for (final s in prefs.getStringList(_kSeenKey) ?? const <String>[]) {
     final id = int.tryParse(s);
     if (id != null && _shownIds.add(id)) _seenOrder.add(id);
     }
     } catch (_) {}
     }
     Future<void> _saveSeen() async {
     try {
     if (_seenOrder.length > _kSeenKeep) {
     _seenOrder.removeRange(0, _seenOrder.length - _kSeenKeep);
     }
     final prefs = await SharedPreferences.getInstance();
     await prefs.setStringList(
     _kSeenKey,
     _seenOrder.map((e) => '$e').toList(),
     );
     } catch (_) {}
     }
     Future<void> _loadIdRange() async {
     try {
     final db = await DataBaseManager.getInstance();
     final r = await db
     .query('SELECT MIN(Id) AS a, MAX(Id) AS b FROM HitomiColumnModel')
     .timeout(const Duration(seconds: 5));
     if (r.isNotEmpty) {
     _minId = int.tryParse('${r.first['a']}');
     _maxId = int.tryParse('${r.first['b']}');
     }
     } catch (_) {}
     }
     Future<void> _loadBase() async {
     _excluded = Settings.excludeTags.value
     .map(_norm)
     .where((e) => e.isNotEmpty)
     .toSet();
     final bookmark = await Bookmark.getInstance();
     for (final a in await bookmark.getArticle()) {
     final id = int.tryParse(a.article().trim());
     if (id != null) _bookmarkedIds.add(id);
     }
     try {
     final artists = await bookmark.getArtist();
     _favArtists = artists.map((a) => (a.artist(), a.type())).toList();
     } catch (_) {
     _favArtists = [];
     }
     try {
     final logs = await (await User.getInstance()).getUserLog();
     for (final log in logs) {
     final id = int.tryParse('${log.result['Article']}');
     if (id != null && _readIds.add(id)) _recentReadIds.add(id);
     }
     } catch (_) {}
     }
     void _addTags(_Profile p, QueryResult m, double w) {
     final seen = <String>{};
     for (final (group, name) in _tagsOf(m)) {
     final token = _tokenOf(group, name);
     if (token.isEmpty || _isExcluded(token) || !seen.add(token)) continue;
     p.weights[token] = (p.weights[token] ?? 0) + w;
     }
     }
     void _buildVec(_Profile p) {
     p.vec.clear();
     p.weights.forEach((token, w) {
     final key = HentaiIndex.tagIndex[token.replaceAll('_', ' ')];
     if (key != null) p.vec[key.toString()] = w;
     });
     }
     Future<void> _buildTasteProfile(_Profile p) async {
     _setStatus('북마크 분석 중...');
     final sample = _bookmarkedIds.toList()..shuffle(_rand);
     final metas = await _loadMetadata(
     sample.take(_kProfileArticleLimit).toList(),
     maxNetwork: _kNetworkFetchLimit,
     );
     p.sourceCount = metas.length;
     for (final m in metas.values) {
     _addTags(p, m, 1.0);
     }
     for (final raw in Settings.favoriteTags.value) {
     final token = _norm(raw);
     if (token.isEmpty || _isExcluded(token)) continue;
     p.weights[token] = (p.weights[token] ?? 0) + 3.0;
     }
     p.artists = List.of(_favArtists);
     _buildVec(p);
     }
     Future<void> _buildRecentProfile(_Profile p) async {
     _setStatus('최근 본 작품 분석 중...');
     final recent = _recentReadIds.take(_kRecentLimit).toList();
     final metas = await _loadMetadata(recent, maxNetwork: _kNetworkFetchLimit);
     p.sourceCount = metas.length;
     final artistW = <(String, ArtistType), double>{};
     for (var i = 0; i < recent.length; i++) {
     final m = metas[recent[i]];
     if (m == null) continue;
     final w = 1.0 / (1.0 + i / 8.0); // 최근에 본 것일수록 크게
     _addTags(p, m, w);
     for (final a in _splitNames(m.artists())) {
     final k = (a, ArtistType.artist);
     artistW[k] = (artistW[k] ?? 0) + w;
     }
     for (final g in _splitNames(m.groups())) {
     final k = (g, ArtistType.group);
     artistW[k] = (artistW[k] ?? 0) + w;
     }
     }
     final ranked = artistW.entries.toList()
     ..sort((a, b) => b.value.compareTo(a.value));
     p.artists = ranked.take(10).map((e) => e.key).toList();
     _buildVec(p);
     }
     double _score(_Profile p, QueryResult m) {
     final tags = _tagsOf(m);
     if (tags.isEmpty) return 0;
     var s = 0.0;
     for (final (group, name) in tags) {
     final w = p.weights[_tokenOf(group, name)];
     if (w != null) s += sqrt(w);
     }
     return s / sqrt(tags.length);
     }
     void _addCand(_Profile p, QueryResult q, double bonus, String reason) {
     final id = _idOf(q);
     if (id == null || !_isNew(id) || _hasExcluded(q)) return;
     final score = _score(p, q) + bonus;
     final old = p.pool[id];
     if (old == null || score > old.score) {
     p.pool[id] = _Cand(id, q, score, reason);
     }
     }
     int _available(_Profile p) => p.pool.keys.where(_isNew).length;
     String _withFilters(String tokens) => translate2query(
     '$tokens ${Settings.includeTags.value} ${Settings.serializedExcludeTags}'
     .trim(),
     );
     Future<List<QueryResult>> _localQuery(
     String tokens, {
     required int limit,
     required int maxPage,
     }) async {
     try {
     final sql = _withFilters(tokens);
     var page = maxPage <= 1 ? 0 : _rand.nextInt(maxPage);
     for (var i = 0; i < 3; i++) {
     final qm = QueryManager.queryPagination(sql, limit);
     qm.curPage = page;
     final list = await qm.next().timeout(const Duration(seconds: 10));
     if (list.isNotEmpty || page == 0) return list;
     page = page ~/ 4;
     }
     } catch (_) {}
     return [];
     }
     String _tagLabel(_Mode mode) =>
     mode == _Mode.taste ? '취향 태그' : '최근 본 작품과 비슷함';
     Future<void> _quickFill(_Profile p, _Mode mode, int chunks) async {
     if (!_hasDb || p.weights.isEmpty) return;
     final span = (_maxId! - _minId!).toDouble();
     for (var i = 0; i < chunks; i++) {
     final before = _maxId! + 1 - (span * pow(_rand.nextDouble(), 2)).toInt();
     var sql = _withFilters('');
     sql += sql.contains('WHERE') ? ' AND Id < $before' : ' WHERE Id < $before';
     List<QueryResult> rows;
     try {
     rows = await QueryManager.queryPagination(
     sql,
     _kChunkSize,
     ).next().timeout(const Duration(seconds: 8));
     } catch (_) {
     continue;
     }
     final scored = <(QueryResult, double)>[];
     for (final q in rows) {
     final s = _score(p, q);
     if (s > 0) scored.add((q, s));
     }
     scored.sort((a, b) => b.$2.compareTo(a.$2));
     for (final (q, _) in scored.take(_kKeepPerChunk)) {
     _addCand(p, q, 0, _tagLabel(mode));
     }
     }
     }
     String? _pickToken(_Profile p) {
     final entries = p.weights.entries.toList();
     if (entries.isEmpty) return null;
     final ws = entries.map((e) => sqrt(e.value)).toList();
     var r = _rand.nextDouble() * ws.fold<double>(0, (a, b) => a + b);
     for (var i = 0; i < entries.length; i++) {
     r -= ws[i];
     if (r <= 0) return entries[i].key;
     }
     return entries.last.key;
     }
     Future<void> _fillTags(_Profile p, _Mode mode, int n) async {
     final tried = <String>{};
     for (var k = 0; k < n; k++) {
     final token = _pickToken(p);
     if (token == null) return;
     if (!tried.add(token)) continue;
     if (_hasDb) {
     for (final q in await _localQuery(token, limit: 30, maxPage: 15)) {
     _addCand(p, q, 0.5, '${_tagLabel(mode)}: $token');
     }
     } else {
     final ids = await _fetchIds(token);
     final fresh = ids.where(_isNew).toList()..shuffle(_rand);
     final metas = await _loadMetadata(
     fresh.take(12).toList(),
     maxNetwork: 12,
     );
     for (final q in metas.values) {
     _addCand(p, q, 0.5, '${_tagLabel(mode)}: $token');
     }
     }
     }
     }
     bool _safeName(String n) =>
     n.isNotEmpty &&
     !n.contains("'") &&
     !n.contains('"') &&
     !n.contains('(') &&
     !n.contains(')');
     String _orTokens(Iterable<(String, ArtistType)> list) =>
     '(${list.map((e) => '${e.$2.name}:${e.$1.replaceAll(' ', '_')}').join(' or ')})';
     String? _matchName(QueryResult q, Iterable<String> names) {
     final hay =
     '|${q.artists()}|${q.groups() ?? ''}|'
     '${q.result['Series'] ?? ''}|${q.result['Characters'] ?? ''}|'
     .toLowerCase();
     for (final n in names) {
     if (hay.contains('|${n.toLowerCase()}|')) return n;
     }
     return null;
     }
     Future<List<QueryResult>> _networkArtists(
     Iterable<(String, ArtistType)> list,
     ) async {
     final out = <QueryResult>[];
     for (final (name, type) in list) {
     try {
     final r = await HybridLoader.fetchArtistArticlesHybrid(
     name: name,
     type: type.name,
     language: _lang(),
     ).timeout(const Duration(seconds: 15));
     out.addAll((List<QueryResult>.of(r)..shuffle(_rand)).take(10));
     } catch (_) {}
     }
     return out;
     }
     Future<void> _fillArtists(_Profile p, _Mode mode) async {
     final list = p.artists.where((e) => _safeName(e.$1)).toList();
     if (mode == _Mode.taste) list.shuffle(_rand);
     if (list.isEmpty) return;
     final use = list.take(20).toList();
     final rows = _hasDb
     ? await _localQuery(_orTokens(use), limit: 60, maxPage: 5)
     : await _networkArtists(use.take(3));
     final names = use.map((e) => e.$1).toList();
     final label = mode == _Mode.taste ? '즐겨찾는 작가' : '최근 본 작가';
     for (final q in rows) {
     final who = _matchName(q, names);
     _addCand(
     p,
     q,
     mode == _Mode.taste ? 3.0 : 2.0,
     who == null ? label : '$label: $who',
     );
     }
     }
     Future<void> _computeSimilar(_Profile p, _Mode mode) async {
     if (p.similarComputed) return;
     p.similarComputed = true;
     final own = {...p.artists.map((e) => e.$1), ..._favArtists.map((e) => e.$1)};
     final cand = <String, (ArtistType, double, String)>{};
     final picks = p.artists
     .where((e) => e.$2 == ArtistType.artist || e.$2 == ArtistType.group)
     .toList();
     if (mode == _Mode.taste) picks.shuffle(_rand);
     for (final (name, type) in picks.take(4)) {
     await Future<void>.delayed(Duration.zero);
     final isGroup = type == ArtistType.group;
     List<(String, double)> sims = [];
     try {
     sims = isGroup
     ? HentaiIndex.calculateSimilarGroups(name)
     : HentaiIndex.calculateSimilarArtists(name);
     } catch (_) {}
     final vecs = isGroup ? HentaiIndex.tagGroup : HentaiIndex.tagArtist;
     for (final (other, baseSim) in sims.take(12)) {
     if (own.contains(other) ||
     cand.containsKey(other) ||
     !_safeName(other)) {
     continue;
     }
     var rank = baseSim;
     final vec = vecs[other];
     if (p.vec.isNotEmpty && vec is Map<String, dynamic>) {
     rank = Distance.cosineDistance(p.vec, vec);
     }
     cand[other] = (type, rank, name);
     }
     }
     final ranked = cand.entries.where((e) => e.value.$2 > 0).toList()
     ..sort((a, b) => b.value.$2.compareTo(a.value.$2));
     p.similar
     ..clear()
     ..addAll(
     ranked
     .take(10)
     .map((e) => (e.key, e.value.$1, e.value.$2, e.value.$3)),
     );
     }
     Future<void> _fillSimilar(_Profile p, _Mode mode) async {
     await _computeSimilar(p, mode);
     if (p.similar.isEmpty) return;
     final pick = (List.of(p.similar)..shuffle(_rand)).take(8).toList();
     final pairs = pick.map((e) => (e.$1, e.$2));
     final rows = _hasDb
     ? await _localQuery(_orTokens(pairs), limit: 60, maxPage: 5)
     : await _networkArtists(pairs.take(3));
     final names = pick.map((e) => e.$1).toList();
     for (final q in rows) {
     final who = _matchName(q, names);
     if (who == null) continue;
     final info = pick.firstWhere((e) => e.$1 == who);
     _addCand(
     p,
     q,
     1.0 + info.$3 / 100 * 2.0,
     '비슷한 작가: $who (${info.$4} 기준)',
     );
     }
     }
     Future<void> _backgroundFill(_Mode mode) async {
     if (!_fillingModes.add(mode)) return;
     final p = _profiles[mode]!;
     if (mounted) setState(() {});
     try {
     await _fillTags(p, mode, 3);
     await _quickFill(p, mode, 4);
     await _fillArtists(p, mode);
     await _fillSimilar(p, mode);
     } catch (_) {
     } finally {
     _fillingModes.remove(mode);
     if (mounted) {
     if (_mode == mode && !_loading && _results.isEmpty) {
     _draw();
     } else {
     setState(() {});
     }
     }
     }
     }
     Future<Map<int, QueryResult>> _loadMetadata(
     List<int> ids, {
     required int maxNetwork,
     }) async {
     final out = <int, QueryResult>{};
     if (ids.isEmpty) return out;
     try {
     final local = await QueryManager.queryIds(
     ids,
     ).timeout(const Duration(seconds: 8));
     for (final q in local) {
     final id = _idOf(q);
     if (id != null) out[id] = q;
     }
     } catch (_) {}
     var rest = ids.where((e) => !out.containsKey(e)).toList();
     if (rest.isNotEmpty) {
     try {
     out.addAll(
     await HybridLoader.getCachedMetadataBatch(
     rest,
     ).timeout(const Duration(seconds: 8)),
     );
     } catch (_) {}
     }
     rest = ids.where((e) => !out.containsKey(e)).take(maxNetwork).toList();
     for (var i = 0; i < rest.length; i += 6) {
     final chunk = rest.skip(i).take(6).toList();
     final fetched = await Future.wait(
     chunk.map((id) async {
     try {
     return await HybridLoader.idQueryHitomiFast(
     id,
     ).timeout(const Duration(seconds: 6));
     } catch (_) {
     return null;
     }
     }),
     );
     for (var j = 0; j < chunk.length; j++) {
     final q = fetched[j];
     if (q != null) out[chunk[j]] = q;
     }
     }
     return out;
     }
     Future<List<int>> _fetchIds(String token) async {
     var maxPage = 12;
     for (var i = 0; i < 3; i++) {
     final page = _rand.nextInt(maxPage);
     try {
     final ids = await HybridLoader.fetchGalleryIdsForQuery(
     query: token,
     page: page,
     pageSize: 30,
     targetLang: _lang(),
     ).timeout(const Duration(seconds: 15));
     if (ids.isNotEmpty) return ids;
     } catch (_) {}
     if (maxPage == 1) break;
     maxPage = max(1, maxPage ~/ 4);
     }
     return [];
     }
     Future<void> _enterMode(_Mode mode) async {
     setState(() {
     _mode = mode;
     _loading = true;
     _results = [];
     _message = null;
     _drawInfo = '';
     });
     final p = _profiles[mode]!;
     if (!p.built) {
     try {
     if (mode == _Mode.taste) {
     await _buildTasteProfile(p);
     } else {
     await _buildRecentProfile(p);
     }
     } catch (_) {}
     p.built = true;
     }
     if (!mounted || _mode != mode) return;
     if (p.weights.isEmpty && p.artists.isEmpty) {
     setState(() {
     _loading = false;
     _message = mode == _Mode.taste
     ? '북마크한 작품, 즐겨찾기 태그, 즐겨찾는 작가가 아직 없어요.\n'
     '마음에 드는 작품을 북마크하면 취향을 계산해서 추천해 드려요.'
     : '최근 본 작품이 아직 없어요.\n'
     '작품을 몇 개 보고 오면 비슷한 작품을 추천해 드려요.';
     });
     return;
     }
     if (_available(p) < _kResultCount) {
     await _step(
     '취향에 맞는 작품 찾는 중...',
     () => _hasDb ? _quickFill(p, mode, 3) : _fillTags(p, mode, 3),
     );
     await _step(
     mode == _Mode.taste ? '즐겨찾는 작가 작품 찾는 중...' : '최근 본 작가 작품 찾는 중...',
     () => _fillArtists(p, mode),
     );
     await _step('비슷한 작가 찾는 중...', () => _fillSimilar(p, mode));
     }
     if (!mounted || _mode != mode) return;
     _backgroundFill(mode);
     _draw();
     }
     void _draw() {
     final p = _p;
     final keyed =
     p.pool.values
     .where((c) => _isNew(c.id))
     .map(
