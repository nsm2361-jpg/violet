     final recognized = await _getRecognizer(
     script,
     ).processImage(InputImage.fromFilePath(file.path));
     if (gen != _gen) return;
     final translator = await _getTranslator(code);
     if (gen != _gen) return;
     final out = <MangaTranslateBox>[];
     for (final block in recognized.blocks) {
     final src = _prepare(block.text, script);
     if (src == null) continue;
     final key = '$code|$src';
     var ko = _cache[key];
     if (ko == null) {
     ko = await translator.translateText(src);
     _cache[key] = ko;
     }
     if (gen != _gen) return;
     final r = block.boundingBox;
     out.add(
     MangaTranslateBox(
     Rect.fromLTRB(r.left / dpr, r.top / dpr, r.right / dpr, r.bottom / dpr),
     ko,
     ),
     );
     }
     boxes.value = out;
     status.value = out.isEmpty ? '번역할 글자를 못 찾았어요' : '';
     } catch (e) {
     if (gen == _gen) status.value = '번역 실패: $e';
     } finally {
     _busy = false;
     }
     }
