  - uses: actions/setup-java@v4
    with:
     distribution: temurin
     java-version: "17"
  - uses: subosito/flutter-action@v2
    with:
     channel: stable
     flutter-version: 3.35.4
  - uses: dtolnay/rust-toolchain@stable
  - name: Stub server salt files
    run: |
     echo 'String getValid(String vToken) { return vToken; }' > lib/server/salt.dart
     echo 'String getValid(String vToken) { return vToken; }' > lib/server/wsalt.dart
  - name: Restore signing key
    id: keycache
    uses: actions/cache@v4
    with:
     path: violet/android/build-key.jks
     key: violet-build-key-v1
  - name: Create signing key (first time only)
    if: steps.keycache.outputs.cache-hit != 'true'
    run: |
     keytool -genkeypair -keystore android/build-key.jks -storepass violetlite -keypass violetlite -alias violet -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=Violet Lite Custom"
  - name: Write key.properties
    run: |
     printf 'storePassword=violetlite\nkeyPassword=violetlite\nkeyAlias=violet\nstoreFile=%s\n' "$GITHUB_WORKSPACE/violet/android/build-key.jks" > android/key.properties
  - name: Build APK (arm64)
    run: |
     flutter pub get
     flutter build apk --release --target-platform android-arm64
  - name: Publish APK to Releases
    env:
     GH_TOKEN: ${{ github.token }}
    run: |
     cp build/app/outputs/flutter-apk/app-release.apk violet-ai.apk
     gh release delete ai-latest --repo "$GITHUB_REPOSITORY" --yes --cleanup-tag || true
     gh release create ai-latest violet-ai.apk --repo "$GITHUB_REPOSITORY" --target "$GITHUB_SHA" --title "Violet AI 추천 + 번역 (최신)" --notes "빌드 번호 $GITHUB_RUN_NUMBER"
